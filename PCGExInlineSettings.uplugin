{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0.0",
  "FriendlyName": "PCGEx | Inline Settings",
  "Description": "Inline, instanced PCG settings. Hosts an instance of any non-abstract PCG settings class inside a small struct, and exposes it to graphs as a soft object path so it can be used as a graph parameter.",
  "Category": "PCG",
  "CreatedBy": "Timothé Lapetite",
  "CreatedByURL": "https://github.com/PCGEx/PCGExInlineSettings",
  "DocsURL": "https://github.com/PCGEx/PCGExInlineSettings",
  "SupportURL": "https://discord.gg/mde2vC5gbE",
  "CanContainContent": false,
  "EngineVersion": "5.7.0",
  "IsBetaVersion": false,
  "Installed": false,
  "Modules": [
    {
      "Name": "PCGExInlineSettings",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Win64",
        "Mac",
        "Linux",
        "LinuxArm64",
        "Android",
        "IOS"
      ]
    },
    {
      "Name": "PCGExInlineSettingsEditor",
      "Type": "Editor",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Win64",
        "Mac",
        "Linux"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "PCG",
      "Enabled": true
    }
  ]
}
